
# Trading silo wake.toml - generic core + trading specialization

base_dir = "/srv/relay/mailboxes"
poll_interval = 2
acl_path = "/srv/relay/acl.json"
recover_stale_after = 300

prompt_template = """You have new mailbox message from {from} in thread {thread_id}:
{body}

Attachments folder: {attachment_folder_container}
{attachments_list}

Read /work/AGENTS.md and /work/docs/*.md
If attachments present, read raw files in natural state:
- Chart images: use Read tool with image path, levels are on chart image that trading agents read (analyst writes line or two but levels are on chart)
- PDFs/CSVs: read raw file, do not rely on system processing
Files never get processed by system only read by you in natural state like email/discord.
PWA is email/BBS style, zero processing, sends raw files through message.
X feed contains raw chart images, levels on chart.
Do work per docs, update /work/strategy.py if training, log to /work/training.log
Reply: relay reply --message {msg_id} --from {agent} --body 'reply'
Session {agent} persistent via /work/muse-session-id.
"""

[executors]
default = "echo 'Agent {agent} got {msg_id} from {from}: {body} Attachments: {attachment_folder_container}'"
agent01 = "sudo -u agent01 bash -c 'SESSION_FILE=/home/agent01/work/muse-session-id; if [ ! -f $SESSION_FILE ]; then if [ -f /work/muse-session-id ]; then cp /work/muse-session-id $SESSION_FILE; else UUID=$(cat /proc/sys/kernel/random/uuid); echo "agent01-main-$UUID" > $SESSION_FILE; fi; fi; SID=$(cat $SESSION_FILE); muse exec --session-id $SID --reasoning-effort medium "{prompt}" '"

[jobs.trading-mailbox]
runner = "Muse"
mode = "fix"
events = true
prompt = "prompts/trading-mailbox.md"
capture = "scripts/capture-mailbox.sh"
expect_every_hours = 0
notify_ok = "info"

[[watch]]
name = "mailbox-agent01"
job = "trading-mailbox"
source = "mailbox"
base_dir = "/srv/relay/mailboxes"
pattern = "agent01/pending/*.json"
key_regex = "(?P<key>msg_[a-f0-9]+)"

[[watch]]
name = "mailbox-xfeed"
job = "trading-mailbox"
source = "mailbox"
base_dir = "/srv/relay/mailboxes"
pattern = "*/pending/*.json"
key_regex = "xfeed"

[channels.telegram]
type = "telegram"
token_env = "TELEGRAM_BOT_TOKEN"
chat_id_env = "TELEGRAM_CHAT_ID"

[routing]
info = ["telegram"]
alert = ["telegram"]
urgent = ["telegram"]

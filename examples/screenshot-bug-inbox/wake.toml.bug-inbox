
base_dir = "/home/user/wake/mailboxes"
poll_interval = 2
recover_stale_after = 300

prompt_template = """You have new bug report from {from} in thread {thread_id}:
{body}

Attachments folder: {attachment_folder_container}
{attachments_list}

Read the screenshot image raw - use vision. Describe the bug, steps to reproduce, expected vs actual.
If screenshot shows UI issue, note component and overlap.
Open GitHub issue or log to bugs.log
"""

[executors]
default = "Muse exec --reasoning-effort medium '{prompt}'"
bugs = "Muse exec --reasoning-effort medium '{prompt}'"

[jobs.bug-inbox]
runner = "Muse"
mode = "fix"
events = true
prompt = "prompts/bug-inbox.md"
capture = "scripts/capture-bug-inbox.sh"

[[watch]]
name = "screenshots"
job = "bug-inbox"
source = "mailbox"
base_dir = "/home/user/wake/mailboxes"
pattern = "bugs/pending/*.json"
key_regex = "(?P<key>msg_[a-f0-9]+)"
